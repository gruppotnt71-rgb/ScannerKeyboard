<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📲 Lettore Tag NFC"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNfcStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Avvicina un tag NFC al retro del dispositivo per inserire il contenuto (NDEF o UID) nel campo di testo attivo."
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/cbPreferTagUid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Leggi sempre l'UID esadecimale del Tag (invece del payload NDEF)" />

    <Button
        android:id="@+id/btnCancelNfc"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Annulla" />

</LinearLayout>
