<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanner Keyboard"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Tastiera Android con Scanner Barcode/QR, OCR e NFC integrato"
            android:textSize="14sp" />

        <!-- SEZIONE 1: Setup Wizard -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Configurazione Guidata (Setup Wizard)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSetupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Verifica stato tastiera e permessi..."
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStepEnableIme"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="1. Abilita IME" />

                    <Button
                        android:id="@+id/btnStepSelectIme"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="2. Scegli IME" />

                    <Button
                        android:id="@+id/btnStepGrantCamera"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3. Fotocamera" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SEZIONE 2: Area di Test Live -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Area di Test Scansione &amp; Tastiera"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTestInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Tocca qui per aprire la tastiera o testare lo scanner..."
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTestBarcode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="📷 Test Barcode" />

                    <Button
                        android:id="@+id/btnTestOcr"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔤 Test OCR" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SEZIONE 3: Impostazioni Scanner, Prefisso, Suffisso e Simulazione Tasti -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Formattazione Dati &amp; Simulazione Tasti"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPrefix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Prefisso (es. SKU: o {DATE} )"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etSuffix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Suffisso (es. ; o {TAB} )"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Azione Tasto Finale dopo la scansione:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spPostScanAction"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp" />

                <CheckBox
                    android:id="@+id/cbBeepOnScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Segnale acustico (Beep) alla lettura" />

                <CheckBox
                    android:id="@+id/cbVibrateOnScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vibrazione alla lettura" />

                <CheckBox
                    android:id="@+id/cbTorchAtStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Attiva Flash (Torcia) automaticamente all'avvio scanner" />

                <CheckBox
                    android:id="@+id/cbContinuousScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modalità Batch / Scansione Continua (non chiude la fotocamera)" />

                <CheckBox
                    android:id="@+id/cbAutoScanOnFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-Scan: avvia lo scanner automaticamente al focus di un campo" />

                <CheckBox
                    android:id="@+id/cbShowNumberRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mostra riga numerica (0-9) fissa sopra la tastiera QWERTY" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Salva Impostazioni" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SEZIONE 4: Regole di Modifica Dati (Regex / Sostituzione) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Regole Modifica Dati (Regex / Replace)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Trasforma automaticamente il codice letto (es. rimuovi zeri iniziali ^0+ -> vuoto)."
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etRulePattern"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Pattern Regex"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/etRuleReplacement"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Sostituzione"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btnAddRule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rulesListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SEZIONE 5: Testi Rapidi (Quick Text Shortcuts) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. Testi Rapidi (Quick Texts sulla Tastiera)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etQuickTextSnippet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Nuovo testo rapido..."
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btnAddQuickText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quickTextsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
