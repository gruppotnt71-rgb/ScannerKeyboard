<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kbd_bg"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <!-- Top Scanner & Action Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/kbd_toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <Button
            android:id="@+id/btnScanBarcode"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:backgroundTint="@color/kbd_key_scan_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="📷 Barcode"
            android:textColor="@color/kbd_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnScanOcr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/kbd_key_special_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="🔤 OCR"
            android:textColor="@color/kbd_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnScanNfc"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/kbd_key_special_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="📲 NFC"
            android:textColor="@color/kbd_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnQuickTextToggle"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/kbd_key_special_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="⚡ Testi"
            android:textColor="@color/kbd_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnImeSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:backgroundTint="@color/kbd_key_special_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="⚙️"
            android:textColor="@color/kbd_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Collapsible Quick-Text Shortcut Bar -->
    <HorizontalScrollView
        android:id="@+id/quickTextScroll"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#18191C"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/quickTextContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp" />
    </HorizontalScrollView>

    <!-- Dynamic QWERTY / Symbols Rows -->
    <LinearLayout
        android:id="@+id/keyboardRowsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="2dp"
        android:paddingTop="4dp" />

</LinearLayout>
